// Atomics (spec 6.15)
enum memory_order { memory_order_relaxed, memory_order_seq_cst };

template <typename T>
struct _atomic {
    T load(memory_order order = memory_order_relaxed) const;
    void store(T value, memory_order order = memory_order_relaxed);
};

typedef _atomic<int> atomic_int;
typedef _atomic<uint> atomic_uint;
typedef _atomic<bool> atomic_bool;
typedef _atomic<float> atomic_float;

template <typename T> T atomic_load_explicit(const _atomic<T>* object, memory_order order);
template <typename T> void atomic_store_explicit(_atomic<T>* object, T desired, memory_order order);
template <typename T> T atomic_exchange_explicit(_atomic<T>* object, T desired, memory_order order);
template <typename T> bool atomic_compare_exchange_weak_explicit(_atomic<T>* object, T* expected, T desired, memory_order success, memory_order failure);
template <typename T> T atomic_fetch_add_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_sub_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_and_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_or_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_xor_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_min_explicit(_atomic<T>* object, T operand, memory_order order);
template <typename T> T atomic_fetch_max_explicit(_atomic<T>* object, T operand, memory_order order);

