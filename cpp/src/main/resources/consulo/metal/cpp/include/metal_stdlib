// The Metal standard library as the editor sees it: declarations written from the Metal Shading Language
// Specification, for completion and resolve. Not Apple's headers, and not how the compiler implements the library.
// The built-in types are in metal_types.

#ifndef CONSULO_METAL_STDLIB
#define CONSULO_METAL_STDLIB

#include <metal_types>

namespace metal {

// Samplers (spec 2.10)
enum class coord { normalized, pixel };
enum class filter { nearest, linear, bicubic };
enum class min_filter { nearest, linear, bicubic };
enum class mag_filter { nearest, linear, bicubic };
enum class mip_filter { none, nearest, linear };
enum class s_address { clamp_to_zero, clamp_to_edge, clamp_to_border, repeat, mirrored_repeat };
enum class t_address { clamp_to_zero, clamp_to_edge, clamp_to_border, repeat, mirrored_repeat };
enum class r_address { clamp_to_zero, clamp_to_edge, clamp_to_border, repeat, mirrored_repeat };
enum class address { clamp_to_zero, clamp_to_edge, clamp_to_border, repeat, mirrored_repeat };
enum class border_color { transparent_black, opaque_black, opaque_white };
enum class compare_func { none, less, less_equal, greater, greater_equal, equal, not_equal, always, never };

struct sampler {
    sampler();
    template <typename... Args>
    constexpr sampler(Args... args);
};

// Textures (spec 2.9)
enum class access { sample, read, write, read_write };

struct level {
    level(uint lod);
};

struct bias {
    bias(float value);
};

template <typename T, access A = access::sample>
struct texture1d {
    vec<T, 4> sample(sampler s, float coord) const;
    vec<T, 4> read(uint coord, uint lod = 0) const;
    void write(vec<T, 4> color, uint coord, uint lod = 0);
    uint get_width(uint lod = 0) const;
};

template <typename T, access A = access::sample>
struct texture2d {
    vec<T, 4> sample(sampler s, float2 coord) const;
    vec<T, 4> sample(sampler s, float2 coord, level lod) const;
    vec<T, 4> sample(sampler s, float2 coord, bias b) const;
    vec<T, 4> read(uint2 coord, uint lod = 0) const;
    void write(vec<T, 4> color, uint2 coord, uint lod = 0);
    vec<T, 4> gather(sampler s, float2 coord) const;
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
    uint get_num_mip_levels() const;
};

template <typename T, access A = access::sample>
struct texture2d_array {
    vec<T, 4> sample(sampler s, float2 coord, uint array) const;
    vec<T, 4> read(uint2 coord, uint array, uint lod = 0) const;
    void write(vec<T, 4> color, uint2 coord, uint array, uint lod = 0);
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
    uint get_array_size() const;
};

template <typename T, access A = access::sample>
struct texture3d {
    vec<T, 4> sample(sampler s, float3 coord) const;
    vec<T, 4> read(uint3 coord, uint lod = 0) const;
    void write(vec<T, 4> color, uint3 coord, uint lod = 0);
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
    uint get_depth(uint lod = 0) const;
};

template <typename T, access A = access::sample>
struct texturecube {
    vec<T, 4> sample(sampler s, float3 coord) const;
    vec<T, 4> read(uint2 coord, uint face, uint lod = 0) const;
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
};

template <typename T, access A = access::sample>
struct depth2d {
    T sample(sampler s, float2 coord) const;
    T sample_compare(sampler s, float2 coord, float compare_value) const;
    T read(uint2 coord, uint lod = 0) const;
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
};

